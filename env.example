# Copy to .env; never commit your .env. Leave these non-secret defaults or choose your own.
SLATE_PORT=8000
# Display and recurrence timezone (an IANA name, for example America/New_York).
SLATE_TIMEZONE=UTC
# REQUIRED: generate once with python -c "import secrets; print(secrets.token_hex(32))"
# Paste the result below. Keep this key stable and back it up with your data.
SLATE_SECRET_KEY=
# Inflated bytes read out of one upload to index it for search/compare (default 64 MiB). An upload over it
# still succeeds and opens; it is only not searchable. See deploy/server/env.example.
# SLATE_DOC_EXTRACT_MAX_BYTES=67108864
# Days finished webhook delivery rows are kept before the dispatcher prunes them (0 = for ever).
SLATE_DELIVERY_RETENTION_DAYS=30
# Optional archive/worktree build identity; normal Git clones are detected automatically.
# SLATE_REV=
# SLATE_COMMIT=
