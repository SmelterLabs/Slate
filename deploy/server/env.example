# Template for $SLATE_HOME/.env (default /opt/slate/.env; mode 600, never committed). Every Slate setting is
# SLATE_<NAME>; anything left out uses the default in src/slate/settings.py.

# SQLite file inside the container; /data is $SLATE_HOME/data on the host.
SLATE_DATABASE_PATH=/data/slate.db
# Display and recurrence timezone (an IANA name, for example America/New_York).
SLATE_TIMEZONE=UTC
# Encrypts webhook secrets at rest. Generate: python3 -c "import secrets;print(secrets.token_hex(32))"
# Losing or changing it makes every stored webhook secret unreadable.
SLATE_SECRET_KEY=<generate>
# Built board inside the image (the Dockerfile copies it here).
SLATE_STATIC_DIR=/app/src/slate/static
# Run recurrence spawning and due events in-process. Leave true in production.
SLATE_SCHEDULER_ENABLED=true
# Seconds between scheduler ticks.
SLATE_SCHEDULER_INTERVAL_SECONDS=60
# Run automation rules (live, in-process). Leave true in production.
SLATE_AUTOMATIONS_ENABLED=true
# Phone and desktop notifications (Web Push). Needs SLATE_SECRET_KEY. Leave true.
SLATE_PUSH_ENABLED=true
# Seconds to wait for a webhook receiver before the attempt counts as failed.
SLATE_WEBHOOK_TIMEOUT_SECONDS=10
# Delay before each retry, in seconds; the list length is the number of retries after the first attempt.
SLATE_WEBHOOK_RETRY_SECONDS=[10,60,300,1800,7200]
# How many webhook deliveries may be in flight at once.
SLATE_WEBHOOK_CONCURRENCY=8
# Days finished webhook delivery rows (ok, failed, skipped, retry) are kept before the dispatcher prunes them;
# queued rows are never pruned. 0 keeps the whole delivery log for ever.
SLATE_DELIVERY_RETENTION_DAYS=30
# Let webhooks and automations post to private addresses (loopback, LAN, tailnet, bare names). Off by default:
# a write token could otherwise probe the services next to Slate. Turn on for a receiver on this host or network.
SLATE_WEBHOOK_PRIVATE_TARGETS=false
# Hosts a browser's push endpoint may be on (JSON list of glob patterns; ["*"] allows any). Default: the common browsers' push services.
SLATE_PUSH_ENDPOINT_HOSTS=["fcm.googleapis.com","*.push.apple.com","*.push.services.mozilla.com","*.notify.windows.com","*.push.samsungosp.com"]
# The contact push services see for this board (a mailto: or https: URL, e.g. mailto:admin@example.com). Empty = SLATE_PUBLIC_URL when it is https.
SLATE_PUSH_SUBJECT=
# Per-token rate limits (a runaway agent loop gets 429s); false turns both off.
SLATE_RATE_LIMIT_ENABLED=true
# Reads per minute per token (burst of the same size); 0 = unlimited.
SLATE_RATE_LIMIT_READS_PER_MINUTE=1200
# Writes per minute per token (burst of the same size); 0 = unlimited.
SLATE_RATE_LIMIT_WRITES_PER_MINUTE=300
# Days a trashed task waits before it is deleted for good (0 keeps the trash until someone empties it).
SLATE_TRASH_DAYS=30
# Health page: a call at least this slow (ms) counts as slow.
SLATE_HEALTH_SLOW_MS=1000
# Health page: a background job that fails this many runs in a row alerts owners and admins.
SLATE_HEALTH_ALERT_AFTER=3
# URL schemes an agent's Open link may use (JSON list). Add a desktop app's scheme so a card can open the agent's own chat window.
SLATE_LINK_SCHEMES=["http","https"]
# Inflated bytes the server reads out of one uploaded file to index it for search and compare (an XLSX/DOCX
# part after unzipping, a PDF's page streams after decoding). Over it the upload still succeeds and opens as
# usual; it is only not searchable or comparable. Generous on purpose: it exists for a 1 MB zip bomb.
SLATE_DOC_EXTRACT_MAX_BYTES=67108864
# AI add (POST /items/ai): the Ollama server whose model fills in a task described in plain
# words. Empty turns AI add off (the board hides its switch). An Ollama on this host is
# http://host.docker.internal:11434 (RUNBOOK.md, "AI add").
SLATE_AI_URL=
# The Ollama model AI add uses (pulled on the host: `ollama pull gemma4:latest`).
SLATE_AI_MODEL=gemma4:latest
# Seconds to wait for the model before the card stays as typed.
SLATE_AI_TIMEOUT=120
# Email notifications (Notifications > Tell me when > Email): any SMTP server. Empty host turns
# email off (the board hides the column). Port 465 is TLS; other ports use STARTTLS. With Resend:
# host smtp.resend.com, user "resend", password = a Resend API key, from = a verified sender.
SLATE_SMTP_HOST=
# SMTP port: 465 is TLS from the start; anything else upgrades with STARTTLS.
SLATE_SMTP_PORT=465
# SMTP login user (empty = no login).
SLATE_SMTP_USER=
# SMTP login password (with Resend: an API key). Never commit it.
SLATE_SMTP_PASSWORD=
# The sender address emails come from (must be allowed by the SMTP provider).
SLATE_SMTP_FROM=Slate <slate@example.com>
# The board's address, so links in emails open it (e.g. https://slate.example.com).
SLATE_PUBLIC_URL=
