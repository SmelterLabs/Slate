{
  "name": "Slate",
  "short_name": "Slate",
  "description": "A task board, shared with your agents.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#16171b",
  "theme_color": "#1c1d22",
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
